# URL base de la API, sin barra final y sin /api.
# En desarrollo se deja vacía: el proxy de Vite reenvía /api a localhost:3000.
# En producción: https://api.estudio.com (reemplazar por el subdominio real).
VITE_API_URL=

# Dirección pública del sitio, con https:// y sin barra final (spec 007). El prerenderizado la
# usa para la dirección principal de cada página, la vista previa al compartir y el sitemap.xml.
# Sin ella, `pnpm --filter web build` falla con "Falta VITE_URL_SITIO".
# En producción: https://estudio.com (reemplazar por el dominio real).
VITE_URL_SITIO=

# Modo demo (spec 009): "true" muestra las cuentas de prueba en el ingreso y deja todas las
# páginas fuera de los buscadores. Apagado si falta o tiene cualquier otro valor. Solo para el
# sitio de la demo: nunca en el de un estudio real.
VITE_MODO_DEMO=
