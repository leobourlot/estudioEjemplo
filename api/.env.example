# Copiar como .env (desarrollo) y .env.test (tests e2e) y completar con los datos reales.
# Nunca usar la base de producción en ninguno de los dos.

# Puerto HTTP de la API (por defecto 3000).
PORT=3000

# Conexión a MySQL. DB_PORT por defecto: 3306.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Secreto para firmar los tokens de acceso. Mínimo 32 caracteres, aleatorio.
JWT_SECRET=

# Cantidad de proxys delante de la API: 0 en desarrollo, 1 en Easypanel (Traefik).
TRUST_PROXY_HOPS=0

# Orígenes del frontend permitidos por CORS, separados por comas.
# Desarrollo: http://localhost:5173 — Producción: https://estudio.com,https://www.estudio.com
FRONTEND_ORIGINS=http://localhost:5173

# Modo demo (spec 009): true protege las cuentas de prueba y permite restablecer los datos de
# muestra con demo:restablecer. Solo en el servicio de la demo; false o vacío en cualquier otro.
MODO_DEMO=false

# Plan de la publicación (spec 011): basico o premium, en minúsculas. Obligatoria: sin ella, o con
# otro valor, la api no arranca. En desarrollo y en tests, premium (los tests del plan Básico lo
# indican desde el propio test). Con MODO_DEMO=true, tiene que ser premium.
PLAN=premium

# Espacio total para PDF del plan Premium, en GB enteros de 1 a 1000 (spec 011). Opcional: 10 si
# falta. Con el plan Básico no se usa. Antes de aumentarlo, verificar el disco y las copias.
ESPACIO_PDF_GB=10
